PORT=3001
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
FRONTEND_URL=http://localhost:5173
ADMIN_PASSWORD=your_admin_password
JWT_SECRET=your_jwt_secret
RESEND_API_KEY=re_your_api_key_from_resend_com
POS_API_URL=https://api.rotibakarngeunah.my.id/api/api.php
POS_API_KEY=same_value_as_point_of_sales_API_SECRET_KEY
INVENTORY_API_URL=https://inventory.rotibakarngeunah.my.id/api

# Integrasi Staff Portal — deteksi otomatis outlet Full Shift yang libur (server/routes/holidays.js).
# STAFF_PORTAL_API_KEY harus sama persis dengan PO_API_KEY di staff_portal .env.
# Kosongkan keduanya untuk menonaktifkan deteksi ini (kalender libur manual tetap jalan).
STAFF_PORTAL_API_URL=https://staff-portal-rbn.vercel.app/api
STAFF_PORTAL_API_KEY=same_value_as_staff_portal_PO_API_KEY

# Integrasi investor-dashboard (dashboard-mitra.rotibakarngeunah.my.id) — mitra
# login di sana, panggil endpoint /api/mitra-purchases server-to-server lewat
# header X-Service-Key. Harus SAMA PERSIS dengan PO_SERVICE_API_KEY di
# investor-dashboard/.env.local.
INVESTOR_DASHBOARD_API_KEY=generate_a_long_random_secret

# Image server for distribution proof photos (FTP/SFTP — fill in when available)
# Currently using Supabase Storage as the upload backend.
IMAGE_SERVER_HOST=
IMAGE_SERVER_USER=
IMAGE_SERVER_PASS=
IMAGE_SERVER_PATH=/distribusi/
